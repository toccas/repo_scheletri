[sub_resource type="Resource" id="Resource_vol0"]
script = ExtResource("1_a2oli")
testo = "Guarda il cielo! Arrivano eroi volanti: puntano dritti alla torre, sopra ostacoli e scheletri."
espressione = 4

[sub_resource type="Resource" id="Resource_vol1"]
script = ExtResource("1_a2oli")
testo = "Spade e asce non ci arrivano. Li colpiscono solo le unità a distanza, la mia torre e le magie: tieni qualche arciere in squadra."

[resource]
