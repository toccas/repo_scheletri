[sub_resource type="Resource" id="Resource_pot0"]
script = ExtResource("1_a2oli")
testo = "Un trucco da vecchio necromante: se evochi un'unità dello stesso tipo sopra una squadra già schierata, la potenzi."
espressione = 1

[sub_resource type="Resource" id="Resource_pot1"]
script = ExtResource("1_a2oli")
testo = "La squadra sale di livello: più vita, colpi più forti, e chi era caduto torna subito in campo. Fino al livello 3."
espressione = 3

[sub_resource type="Resource" id="Resource_pot2"]
script = ExtResource("1_a2oli")
testo = "Costa un'evocazione, come una squadra nuova. Tocca una delle tue squadre per provare: funziona anche con le evocazioni del level-up."

[resource]
script = ExtResource("2_8x4u6")
id = "potenziamento"
battute = Array[ExtResource("1_a2oli")]([SubResource("Resource_pot0"), SubResource("Resource_pot1"), SubResource("Resource_pot2")])
