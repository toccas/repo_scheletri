[gd_resource type="Resource" script_class="Dialogo" format=3]

[ext_resource type="Script" path="res://scripts/battuta_dialogo.gd" id="1_bat"]
[ext_resource type="Script" path="res://scripts/dialogo.gd" id="2_dia"]

[sub_resource type="Resource" id="Resource_l1"]
script = ExtResource("1_bat")
testo = "Il cimitero non è l'unico posto dove gli eroi vengono a morire."
espressione = 1

[sub_resource type="Resource" id="Resource_l2"]
script = ExtResource("1_bat")
testo = "Supera tutte le ondate di un campo di battaglia e si aprirà il successivo."

[sub_resource type="Resource" id="Resource_l3"]
script = ExtResource("1_bat")
testo = "Attento: in alcuni campi ci sono acqua, crepacci e macerie. Lì non si schiera nessuno, e i nemici avanzano solo nelle corsie libere."
espressione = 3

[sub_resource type="Resource" id="Resource_l4"]
script = ExtResource("1_bat")
testo = "Un campo finito si può rigiocare in modalità infinita: ondate senza fine e una classifica delle tue corse migliori."
espressione = 1

[resource]
script = ExtResource("2_dia")
id = "livelli"
battute = Array[ExtResource("1_bat")]([SubResource("Resource_l1"), SubResource("Resource_l2"), SubResource("Resource_l3"), SubResource("Resource_l4")])
