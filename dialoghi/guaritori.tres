[sub_resource type="Resource" id="Resource_gua0"]
script = ExtResource("1_a2oli")
testo = "Vedi quelli vestiti di bianco, in fondo alla fila? Sono guaritori: rimettono in piedi gli eroi che abbiamo ferito."
espressione = 4

[sub_resource type="Resource" id="Resource_gua1"]
script = ExtResource("1_a2oli")
testo = "Hanno poca vita e restano dietro: abbattili per primi con le unità a distanza e le magie. Anche noi possiamo curarci: cerca il Guaritore scheletro nelle pergamene."

[resource]
