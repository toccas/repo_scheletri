[sub_resource type="Resource" id="Resource_igfap"]
script = ExtResource("1_rbdfy")
testo = "Prima di ogni partita si sceglie la squadra: quattro tipi di scheletri che potrai evocare per tutta la run."

[sub_resource type="Resource" id="Resource_shbhe"]
script = ExtResource("1_rbdfy")
testo = "Clicca un altare, poi un'unità della collezione per metterla lì. Con il tasto destro svuoti un altare."

[sub_resource type="Resource" id="Resource_vp3mu"]
